{
  "name": "recalltag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "vite --host 0.0.0.0 --port 3002",
    "test:browser": "node checks/browser.mjs && node checks/extended.mjs",
    "check": "node --check model.mjs && node --check app.mjs && npm test",
    "build": "vite build",
    "test:contract": "cargo test --manifest-path contract/Cargo.toml",
    "test:sandbox": "node checks/sandbox.mjs",
    "test:enhancements": "node checks/enhancements.mjs",
    "build:contract": "bash scripts/build-contract.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "binaryen": "^132.0.0",
    "near-workspaces": "^5.0.0",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "qrcode": "^1.5.4",
    "vite": "^6.4.6"
  },
  "overrides": {
    "tar": "^7.5.12"
  }
}
